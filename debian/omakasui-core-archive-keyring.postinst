#!/bin/sh
set -e

# Disable the one-line source written by the old manual setup, now replaced
# by /etc/apt/sources.list.d/omakasui-core.sources.
if [ "$1" = configure ]; then
	legacy=/etc/apt/sources.list.d/omakasui-core.list
	if [ -f "$legacy" ] && grep -q 'core.omakasui.org' "$legacy"; then
		mv "$legacy" "$legacy.bak"
	fi
fi

#DEBHELPER#

exit 0
